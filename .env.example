# Supabase жобасының баптаулары (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Тек организаторды бастапқы баптау скрипті үшін (браузерге ешқашан берілмейді)
SUPABASE_SERVICE_ROLE_KEY=
# Организатор кабинетіне код арқылы кіру (тек серверде; Vercel-де Sensitive етіп қойыңыз)
ORG_GATE_SECRET=
ORGANIZER_EMAIL=
ORGANIZER_PASSWORD=
